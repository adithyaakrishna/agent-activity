---
import packageInfo from "../../package.json";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://agent-activity.vercel.app");
const rootUrl = new URL("/", siteUrl).href;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const previewUrl = new URL("/agentactivity-preview.png", siteUrl).href;
const iconUrl = new URL("/app-icon.png", siteUrl).href;
const githubUrl = "https://github.com/adithyaakrishna/agent-activity";
const latestReleaseUrl = `${githubUrl}/releases/latest`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${rootUrl}#creator`,
      name: "Adithya Krishna",
      url: "https://github.com/adithyaakrishna",
    },
    {
      "@type": "WebSite",
      "@id": `${rootUrl}#website`,
      url: rootUrl,
      name: "AgentActivity",
      alternateName: ["AgentActivity for macOS", "Agent Activity"],
      description,
      inLanguage: "en",
      creator: { "@id": `${rootUrl}#creator` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${rootUrl}#software`,
      name: "AgentActivity",
      alternateName: "AgentActivity for macOS",
      description,
      url: rootUrl,
      image: [iconUrl, previewUrl],
      sameAs: [githubUrl],
      applicationCategory: "UtilitiesApplication",
      applicationSubCategory: "Developer activity tracker",
      operatingSystem: "macOS 13 or later",
      softwareRequirements: "macOS 13 or later",
      softwareVersion: packageInfo.version,
      datePublished: "2026-08-09",
      downloadUrl: latestReleaseUrl,
      installUrl: latestReleaseUrl,
      isAccessibleForFree: true,
      author: { "@id": `${rootUrl}#creator` },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: latestReleaseUrl,
      },
      featureList: [
        "Calendar heatmaps for Cursor, Codex, Claude, and GitHub",
        "Daily agent actions, tokens, commits, line changes, and active time when available",
        "Privacy-minimized Cursor and Claude hooks",
        "Local repository correlation with explicit folder access",
        "Native menu-bar-only macOS interface",
      ],
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { "@id": `${rootUrl}#website` },
      about: { "@id": `${rootUrl}#software` },
      mainEntity: { "@id": `${rootUrl}#software` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: previewUrl,
        width: 1120,
        height: 596,
      },
      inLanguage: "en",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Adithya Krishna" />
    <meta name="application-name" content="AgentActivity" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content="1120" />
    <meta property="og:image:height" content="596" />
    <meta
      property="og:image:alt"
      content="AgentActivity showing a yearly Codex activity heatmap"
    />
    <meta property="og:site_name" content="AgentActivity" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewUrl} />
    <meta
      name="twitter:image:alt"
      content="AgentActivity showing a yearly Codex activity heatmap"
    />

    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
